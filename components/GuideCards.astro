---
// Cards linking to resource guides: the whole list on the resources hub, or
// the guides related to a page (relatedArticles in data/site.ts).
import { getEntry } from 'astro:content';
import type { Lang } from '../data/portfolio';
import { articlePath, type Article } from '../data/site';
import { longDate } from '../lib/utils';
interface Props { lang: Lang; ids: Article[]; heading: string; }
const { lang, ids, heading } = Astro.props;
const en = lang === 'en';
const entries = await Promise.all(ids.map(async id => {
  const entry = await getEntry('articles', `${lang}/${id}`);
  if (!entry) throw new Error(`Missing article: ${lang}/${id}`);
  return { id, ...entry.data };
}));
---
{entries.length > 0 && <section class="service-section case-related guide-cards" aria-labelledby="guides-heading">
  <h2 id="guides-heading">{heading}</h2>
  <div class="case-related-grid">{entries.map(article => <a href={articlePath(article.id, lang)}>
    <span class="eyebrow">{longDate(article.updated, lang)}</span>
    <h3>{article.heading}</h3><p>{article.description}</p>
    <span class="text-link">{en ? 'Read the guide' : 'Lire le guide'} ↗</span></a>)}</div>
</section>}
