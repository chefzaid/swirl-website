{
  "name": "swirl-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && vite build --config vite.runtime.config.ts",
    "start": "node --env-file-if-exists=.env dist/runtime/main.js",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:coverage": "mkdir -p coverage && node --experimental-strip-types --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"node_modules/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test tests/*.test.ts"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "astro": "7.3.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "postgres": "3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@fontsource/manrope": "5.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "satori": "0.35.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  },
  "type": "module"
}
