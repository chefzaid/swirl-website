{
  "name": "swirl-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && vite build --config vite.runtime.config.ts",
    "start": "node --env-file-if-exists=.env dist/runtime/main.js",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:coverage": "mkdir -p coverage && node --experimental-strip-types --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"node_modules/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "astro": "7.4.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@fontsource/manrope": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.5"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.8.3"
  }
}
