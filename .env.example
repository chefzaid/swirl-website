# SQLite is the default for local development and the production base deployment.
DATA_DIR=.data
# Set DATABASE_URL only for a prepared PostgreSQL database; see docs/high-availability.md.
DATABASE_URL=
# Used by npm start; npm run dev derives its origin from the development server.
PUBLIC_ORIGIN=http://127.0.0.1:8080

# Optional Resend notifications. Verify swirlit.dev for sending first.
# Keep keys empty to save contact enquiries without email notifications.
RESEND_API_KEY=
CONTACT_SENDER=noreply@swirlit.dev

# Optional Microsoft Exchange Online / Microsoft Graph alternative.
# Used only when RESEND_API_KEY is empty; CONTACT_SENDER must be its mailbox.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
