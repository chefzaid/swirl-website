---
import Layout from './Layout.astro';
import SiteFooter from '../../components/SiteFooter';
import ClientLogo from '../../components/ClientLogo';
import { projects, type Lang, type Project } from '../../data/portfolio';
import { absoluteUrl, homePath, projectPath } from '../../data/site';
interface Props { project: Project; lang: Lang; }
const { project, lang } = Astro.props;
const en = lang === 'en';
const home = homePath(lang);
const path = projectPath(project.id, lang);
const related = projects.filter(p => p.id !== project.id && p.sector === project.sector).slice(0, 2);
const title = `${project.client} : ${project.tags[lang][0]} | Swirl IT`;
const breadcrumbs = {
  '@type': 'BreadcrumbList', '@id': absoluteUrl(path) + '#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Swirl', item: absoluteUrl(home) },
    { '@type': 'ListItem', position: 2, name: project.client, item: absoluteUrl(path) },
  ],
};
---
<Layout lang={lang} path={path} title={title} description={project.text[lang]} structuredData={[breadcrumbs]} shareImage={false}>
  <a class="skip-link" href="#main">{en ? 'Skip to content' : 'Aller au contenu'}</a>
  <header class="header wrap case-header">
    <a class="brand" href={home} aria-label="Swirl"><img src="/assets/mark.svg" alt="" width="40" height="38" />Swirl<i>.</i></a>
    <div class="header-actions">
      <div class="language" aria-label={en ? 'Language' : 'Langue'}>
        <a href={projectPath(project.id, 'fr')} lang="fr" aria-label="Français" aria-current={!en ? 'page' : undefined}>FR</a>
        <span aria-hidden="true">/</span>
        <a href={projectPath(project.id, 'en')} lang="en" aria-label="English" aria-current={en ? 'page' : undefined}>EN</a>
      </div>
      <a class="button small" href={`${home}#contact`}>Contact <span aria-hidden="true">↗</span></a>
    </div>
  </header>
  <main id="main" class="case-page wrap">
    <nav class="breadcrumbs" aria-label={en ? 'Breadcrumb' : 'Fil d’Ariane'}><a href={home}>Swirl</a><span aria-hidden="true">/</span><span aria-current="page">{project.client}</span></nav>
    <article>
      <header class="case-intro">
        <ClientLogo id={project.id} />
        <p class="eyebrow section-kicker">{project.client} · {project.date}</p>
        <h1>{project.title[lang]}</h1>
        <p class="case-lead">{project.text[lang]}</p>
        <ul class="tags case-tags" aria-label={en ? 'Project domains' : 'Domaines du projet'}>{project.tags[lang].map(tag => <li>{tag}</li>)}</ul>
      </header>
      <section class="case-body" aria-labelledby="project-heading">
        <h2 id="project-heading">{en ? 'The project' : 'Le projet'}</h2>
        <p>{project.detail[lang]}</p>
        <p class="case-attribution">{en ? 'Project delivered directly or through consulting partnerships.' : 'Projet réalisé directement ou dans le cadre de partenariats de conseil.'}</p>
      </section>
      <aside class="case-contact">
        <h2>{en ? 'Planning a similar project?' : 'Un projet similaire ?'}</h2>
        <p>{en ? 'Tell us what you want to achieve. Swirl supports your project from the first idea to the final result.' : 'Parlez-nous de ce que vous souhaitez accomplir. Swirl accompagne votre projet de l’idée au résultat final.'}</p>
        <a class="button" href={`${home}#contact`}>{en ? 'Let’s talk about your project' : 'Parlons de votre projet'} <span aria-hidden="true">↗</span></a>
      </aside>
    </article>
    {related.length > 0 && <section class="case-related" aria-labelledby="related-heading">
      <h2 id="related-heading">{en ? 'Explore more projects' : 'Découvrez aussi'}</h2>
      <div class="case-related-grid">{related.map(p => <a href={projectPath(p.id, lang)}><span class="eyebrow">{p.client}</span><h3>{p.title[lang]}</h3><p>{p.text[lang]}</p><span class="text-link">{en ? 'Explore the project' : 'Découvrir le projet'} ↗</span></a>)}</div>
    </section>}
    <a class="text-link" href={`${home}#projects`}>← {en ? 'All projects' : 'Tous les projets'}</a>
  </main>
  <SiteFooter lang={lang} />
</Layout>
