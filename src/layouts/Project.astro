---
import Subpage from './Subpage.astro';
import ContactCta from '../components/ContactCta.astro';
import ClientLogo from '../../components/ClientLogo';
import ProjectCaseStudy from '../../components/ProjectCaseStudy';
import { localizeCaseStudy } from '../../data/project-view';
import { projects, services, type Lang, type Project } from '../../data/portfolio';
import { projectServices } from '../../data/expertise';
import { absoluteUrl, projectPath, projectsPath, servicePath, siteConfig, organizationRef } from '../../data/site';
interface Props { project: Project; lang: Lang; }
const { project, lang } = Astro.props;
const en = lang === 'en';
const path = projectPath(project.id, lang);
const related = projects.filter(p => p.id !== project.id && p.sector === project.sector).slice(0, 2);
const expertise = services.filter(service => projectServices(project.id).includes(service.id));
const title = en
  ? `${siteConfig.name} | ${project.client} Case Study: ${project.tags.en[0]}`
  : `${siteConfig.name} | Étude de cas ${project.client} : ${project.tags.fr[0]}`;
const summary = en ? ' The need, our contribution and the solution.' : ' Le besoin, notre contribution et la solution.';
const description = project.text[lang].length + summary.length <= 160 ? project.text[lang] + summary : project.text[lang];
const canonical = absoluteUrl(path);
const caseStudy = {
  '@type': 'CreativeWork', '@id': canonical + '#case-study', name: project.title[lang], abstract: project.text[lang],
  inLanguage: lang, keywords: project.tags[lang].join(', '), temporalCoverage: project.date.replace(' — ', '/'),
  creator: organizationRef,
  about: { '@type': 'Organization', name: project.client },
  isPartOf: { '@id': absoluteUrl(projectsPath(lang)) + '#webpage' },
};
---
<Subpage lang={lang} path={path} title={title} description={description}
  breadcrumbs={[{ name: en ? 'Projects' : 'Références', path: projectsPath(lang) }, { name: project.client, path }]}
  structuredData={[caseStudy]} webPage={{ mainEntity: { '@id': canonical + '#case-study' } }}>
  <article>
    <header class="case-intro">
      <ClientLogo id={project.id} />
      <p class="eyebrow section-kicker">{project.client} · {project.date}</p>
      <h1>{project.title[lang]}</h1>
      <p class="case-lead">{project.text[lang]}</p>
      <ul class="tags case-tags" aria-label={en ? 'Project domains' : 'Domaines du projet'}>{project.tags[lang].map(tag => <li>{tag}</li>)}</ul>
    </header>
    <section class="case-body" aria-labelledby="project-heading">
      <h2 id="project-heading">{en ? 'The project' : 'Le projet'}</h2>
      <ProjectCaseStudy lang={lang} caseStudy={localizeCaseStudy(project.caseStudy, lang)} />
      <p class="case-attribution">{en ? 'Project delivered directly or through consulting partnerships.' : 'Projet réalisé directement ou dans le cadre de partenariats de conseil.'}</p>
      <p class="case-expertise">{en ? 'Related expertise:' : 'Expertises associées :'} {expertise.map((service, index) => <>{index > 0 && ', '}<a href={servicePath(service.id, lang)}>{service.title[lang]}</a></>)}</p>
    </section>
    <ContactCta lang={lang} action="project"
      heading={en ? 'Planning a similar project?' : 'Un projet similaire ?'}
      text={en ? 'Tell us what you want to achieve. Swirl designs your application architecture and integrates it with your business systems, from idea to production.' : 'Parlez-nous de ce que vous souhaitez accomplir. Swirl conçoit l’architecture de vos applications et leur intégration dans votre système d’information, de l’idée à la production.'} />
  </article>
  {related.length > 0 && <section class="case-related" aria-labelledby="related-heading">
    <h2 id="related-heading">{en ? 'Explore more projects' : 'Découvrez aussi'}</h2>
    <div class="case-related-grid">{related.map(p => <a href={projectPath(p.id, lang)}><span class="eyebrow">{p.client}</span><h3>{p.title[lang]}</h3><p>{p.text[lang]}</p></a>)}</div>
  </section>}
  <a class="text-link" href={projectsPath(lang)}>← {en ? 'All projects' : 'Tous les projets'}</a>
</Subpage>
