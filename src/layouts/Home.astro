---
import Layout from './Layout.astro';
import '../../app/swirl-cloud.css';
import Portfolio from '../../components/Portfolio';
import SiteHeader from '../../components/SiteHeader';
import ProjectGallery from '../../components/ProjectGallery';
import ContactForm from '../../components/ContactForm';
import ChatLauncher from '../../components/ChatLauncher';
import type { Lang } from '../../data/portfolio';
import { projectViews } from '../../data/project-view';
import { productPath, projectsPath } from '../../data/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<Layout lang={lang}>
  <Portfolio lang={lang}>
    <SiteHeader slot="header" lang={lang} productHref={productPath(lang)} client:media="(max-width: 1100px)" />
    <ProjectGallery slot="projects-content" lang={lang} projects={projectViews(lang)} projectsHref={projectsPath(lang)} client:visible={{ rootMargin: '300px' }} />
    <ContactForm slot="contact-form" lang={lang} client:visible={{ rootMargin: '300px' }} />
  </Portfolio>
  <ChatLauncher lang={lang} client:idle />
</Layout>
