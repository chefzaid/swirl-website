---
import { getEntry, render } from 'astro:content';
import Subpage from './Subpage.astro';
import GuideCards from '../components/GuideCards.astro';
import '../../app/swirl-cloud.css';
import '../../app/articles.css';
import ContactCta from '../components/ContactCta.astro';
import type { Lang } from '../../data/portfolio';
import { longDate } from '../../lib/utils';
import { absoluteUrl, articlePath, productPath, resourcesPath, relatedArticles, siteConfig, socialImagePath, type Article, organizationRef } from '../../data/site';
interface Props { id: Article; lang: Lang; }
const { id, lang } = Astro.props;
const en = lang === 'en';
const entry = await getEntry('articles', `${lang}/${id}`);
if (!entry) throw new Error(`Missing article: ${lang}/${id}`);
const { Content, headings } = await render(entry);
const sections = headings.filter(heading => heading.depth === 2);
const article = entry.data;
const path = articlePath(id, lang);
const canonical = absoluteUrl(path);
const day = (value: Date) => value.toISOString().slice(0, 10);
const structuredData = [
  { '@type': 'Article', '@id': canonical + '#article', headline: article.heading, description: article.description,
    inLanguage: lang, datePublished: day(article.published), dateModified: day(article.updated),
    author: organizationRef, publisher: organizationRef, image: absoluteUrl(socialImagePath(path)),
    mainEntityOfPage: { '@id': canonical + '#webpage' },
    isPartOf: { '@id': absoluteUrl(resourcesPath(lang)) + '#webpage' },
    citation: article.sources.map(source => source.url) },
];
---
<Subpage lang={lang} path={path} title={`${siteConfig.name} | ${article.title}`} description={article.description}
  breadcrumbs={[{ name: en ? 'Resources' : 'Ressources', path: resourcesPath(lang) }, { name: article.heading, path }]}
  structuredData={structuredData} webPage={{ mainEntity: { '@id': canonical + '#article' } }}>
  <article class="article-page">
    <header class="case-intro">
      <p class="eyebrow section-kicker">{en ? 'RESOURCES' : 'RESSOURCES'}</p>
      <h1>{article.heading}</h1>
      <p class="case-lead">{article.lead}</p>
      <p class="article-meta">{siteConfig.name} · {en ? 'Updated' : 'Mis à jour le'} <time datetime={day(article.updated)}>{longDate(article.updated, lang)}</time></p>
    </header>
    <nav class="article-contents" aria-labelledby="contents-heading">
      <h2 id="contents-heading">{en ? 'Contents' : 'Sommaire'}</h2>
      <ul>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ul>
    </nav>
    <div class="article-body"><Content /></div>
    <section class="article-sources" aria-labelledby="sources-heading">
      <h2 id="sources-heading">Sources</h2>
      <ul>{article.sources.map(source => <li><a href={source.url} rel="noopener noreferrer">{source.label}</a></li>)}</ul>
    </section>
    <GuideCards lang={lang} ids={relatedArticles[id]} heading={en ? 'Related guides' : 'Guides associés'} />
    <ContactCta lang={lang} action="demo"
      heading={en ? 'See Swirl Cloud on a real installation' : 'Voir Swirl Cloud sur une vraie installation'}
      text={en
      ? 'We show you the platform that runs our own website and applications, then size an installation for your company.'
      : 'Nous vous montrons la plateforme qui fait tourner notre propre site et nos applications, puis nous dimensionnons une installation pour votre entreprise.'} />
    <p class="product-more"><a class="text-link" href={productPath(lang)}>{en ? 'Discover Swirl Cloud' : 'Découvrir Swirl Cloud'} <span aria-hidden="true">↗</span></a></p>
  </article>
</Subpage>
