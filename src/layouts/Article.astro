---
import { getEntry, render } from 'astro:content';
import Subpage from './Subpage.astro';
import '../../app/swirl-cloud.css';
import '../../app/articles.css';
import type { Lang } from '../../data/portfolio';
import { absoluteUrl, articlePath, homePath, productPagePath, resourcesPath, siteConfig, socialImagePath, type Article } from '../../data/site';
interface Props { id: Article; lang: Lang; }
const { id, lang } = Astro.props;
const en = lang === 'en';
const entry = await getEntry('articles', `${lang}/${id}`);
if (!entry) throw new Error(`Missing article: ${lang}/${id}`);
const { Content } = await render(entry);
const article = entry.data;
const path = articlePath(id, lang);
const canonical = absoluteUrl(path);
const organization = { '@id': absoluteUrl('/#organization') };
const date = (value: Date) => new Intl.DateTimeFormat(en ? 'en-US' : 'fr-FR', { dateStyle: 'long', timeZone: 'UTC' }).format(value);
const day = (value: Date) => value.toISOString().slice(0, 10);
const demo = `${homePath(lang)}?topic=demo#contact`;
const structuredData = [
  { '@type': 'Article', '@id': canonical + '#article', headline: article.heading, description: article.description,
    inLanguage: lang, datePublished: day(article.published), dateModified: day(article.updated),
    author: organization, publisher: organization, image: absoluteUrl(socialImagePath(path)),
    mainEntityOfPage: { '@id': canonical + '#webpage' },
    isPartOf: { '@id': absoluteUrl(resourcesPath(lang)) + '#webpage' },
    citation: article.sources.map(source => source.url) },
];
---
<Subpage lang={lang} path={path} title={`${siteConfig.name} | ${article.title}`} description={article.description}
  breadcrumbs={[{ name: en ? 'Resources' : 'Ressources', path: resourcesPath(lang) }, { name: article.heading, path }]}
  structuredData={structuredData} webPage={{ mainEntity: { '@id': canonical + '#article' } }}>
  <article class="article-page">
    <header class="case-intro">
      <p class="eyebrow section-kicker">{en ? 'RESOURCES' : 'RESSOURCES'}</p>
      <h1>{article.heading}</h1>
      <p class="case-lead">{article.lead}</p>
      <p class="article-meta">{siteConfig.name} · {en ? 'Updated' : 'Mis à jour le'} <time datetime={day(article.updated)}>{date(article.updated)}</time></p>
    </header>
    <div class="article-body"><Content /></div>
    <section class="article-sources" aria-labelledby="sources-heading">
      <h2 id="sources-heading">Sources</h2>
      <ul>{article.sources.map(source => <li><a href={source.url} rel="noopener noreferrer">{source.label}</a></li>)}</ul>
    </section>
    <aside class="case-contact">
      <h2>{en ? 'See Swirl Cloud on a real installation' : 'Voir Swirl Cloud sur une vraie installation'}</h2>
      <p>{en
        ? 'We show you the controls, reports and evidence pack on our own installation, then size one for your company.'
        : 'Nous vous montrons les contrôles, les rapports et le dossier de preuves sur notre propre installation, puis nous en dimensionnons une pour votre entreprise.'}</p>
      <a class="button" href={demo}>{en ? 'Request a demo' : 'Demander une démo'} <span aria-hidden="true">↗</span></a>
    </aside>
    <p class="product-more"><a class="text-link" href={productPagePath('security', lang)}>{en ? 'Swirl Cloud security and compliance' : 'Sécurité et conformité de Swirl Cloud'} <span aria-hidden="true">↗</span></a></p>
  </article>
</Subpage>
