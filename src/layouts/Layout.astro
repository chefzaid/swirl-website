---
import '../../app/globals.css';
import '../styles/fonts.css';
import headingFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import type { Lang } from '../../data/portfolio';
import { services, applicationService } from '../../data/portfolio';
import { absoluteUrl, documentRoutes, homePath, servicePath, siteConfig, socialImagePath, socialImageSize } from '../../data/site';
interface Props {
  lang: Lang; title?: string; description?: string; path?: string;
  structuredData?: Record<string, unknown>[];
  // Trail after the homepage, rendered as BreadcrumbList.
  breadcrumbs?: { name: string; path: string }[];
  // Extra WebPage properties, e.g. a more specific @type or mainEntity.
  webPage?: Record<string, unknown>;
  // Error documents: no canonical, alternates, social card or structured data.
  noindex?: boolean;
}
const { lang, path = homePath(Astro.props.lang), structuredData = [], breadcrumbs, webPage = {}, noindex = false } = Astro.props;
const en = lang === 'en';
const title = Astro.props.title ?? (en
  ? `${siteConfig.name} | Tailored Software Solutions & Private Cloud`
  : `${siteConfig.name} | Solutions Logicielles Sur Mesure & Cloud Privé`);
const description = Astro.props.description ?? (en
  ? 'Swirl builds tailored web and mobile applications and hosts them in a private cloud. Explore our embedded software, IoT, and AI expertise.'
  : 'Swirl développe vos applications web et mobiles sur mesure et les héberge dans un cloud privé. Découvrez aussi nos expertises en systèmes embarqués, IoT et IA.');
const route = noindex ? undefined : documentRoutes.find(item => item.path === path);
if (!route && !noindex) throw new Error(`Missing SEO route: ${path}`);
const canonical = absoluteUrl(path);
const image = absoluteUrl(socialImagePath(path));
const organizationId = absoluteUrl('/#organization');
const websiteId = absoluteUrl('/#website');
const ceoId = absoluteUrl('/#ceo');
const logoId = absoluteUrl('/#logo');
const graph: Record<string, unknown>[] = [
  { '@type': 'Organization', '@id': organizationId, name: siteConfig.organizationName, alternateName: siteConfig.name,
    url: absoluteUrl('/'), email: siteConfig.email,
    logo: { '@type': 'ImageObject', '@id': logoId, url: absoluteUrl('/logo.png'), contentUrl: absoluteUrl('/logo.png'), width: 512, height: 512, caption: siteConfig.organizationName },
    image: { '@id': logoId }, founder: { '@id': ceoId },
    knowsAbout: services.map(service => service.title[lang]),
    contactPoint: { '@type': 'ContactPoint', email: siteConfig.email, contactType: 'customer service', availableLanguage: ['French', 'English'] } },
  { '@type': 'WebSite', '@id': websiteId, name: siteConfig.name, alternateName: siteConfig.organizationName, url: absoluteUrl('/'), inLanguage: ['fr', 'en'], publisher: { '@id': organizationId } },
  { '@type': 'Person', '@id': ceoId, name: siteConfig.ceo, jobTitle: 'CEO',
    worksFor: { '@id': organizationId }, sameAs: [siteConfig.linkedin], image: absoluteUrl('/assets/portrait.webp') },
  { '@type': 'WebPage', '@id': canonical + '#webpage', url: canonical, name: title, description, inLanguage: lang,
    isPartOf: { '@id': websiteId }, about: { '@id': organizationId },
    primaryImageOfPage: { '@type': 'ImageObject', url: image, ...socialImageSize },
    ...(breadcrumbs ? { breadcrumb: { '@id': canonical + '#breadcrumb' } } : {}), ...webPage },
];
if (breadcrumbs) graph.push({ '@type': 'BreadcrumbList', '@id': canonical + '#breadcrumb',
  itemListElement: [{ name: siteConfig.name, path: homePath(lang) }, ...breadcrumbs].map((crumb, index) => ({
    '@type': 'ListItem', position: index + 1, name: crumb.name, item: absoluteUrl(crumb.path) })) });
if (path === homePath(lang)) {
  for (const service of services) graph.push({ '@type': 'Service', '@id': absoluteUrl(servicePath(service.id, lang)) + '#service',
    name: service.title[lang], description: service.text[lang], provider: { '@id': organizationId }, url: absoluteUrl(servicePath(service.id, lang)) });
  graph.push({ '@type': 'Service', '@id': canonical + '#service-' + applicationService.id,
    name: applicationService.name[lang], description: applicationService.description[lang],
    provider: { '@id': organizationId }, url: canonical + '#home' });
}
// Escape '<' so content cannot terminate the JSON-LD script element.
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [...graph, ...structuredData] }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content="#101211" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/assets/mark.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    {route && <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="fr" href={absoluteUrl(route.alternates.fr)} />
      <link rel="alternate" hreflang="en" href={absoluteUrl(route.alternates.en)} />
      <link rel="alternate" hreflang="x-default" href={absoluteUrl(route.alternates.fr)} />
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content={siteConfig.name} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={canonical} />
      <meta property="og:image" content={image} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content={String(socialImageSize.width)} />
      <meta property="og:image:height" content={String(socialImageSize.height)} />
      <meta property="og:image:alt" content={title} />
      <meta property="og:locale" content={en ? 'en_US' : 'fr_FR'} />
      <meta property="og:locale:alternate" content={en ? 'fr_FR' : 'en_US'} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={image} />
      <meta name="twitter:image:alt" content={title} />
      <script is:inline type="application/ld+json" set:html={jsonLd} />
    </>}
  </head>
  <body id="top"><slot /></body>
</html>
