---
import Subpage from './Subpage.astro';
import '../../app/swirl-cloud.css';
import { services, type Lang } from '../../data/portfolio';
import { servicePages } from '../../data/expertise';
import { product } from '../../data/product';
import { absoluteUrl, homePath, productPagePath, productPath, servicePath, siteConfig } from '../../data/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';
const path = productPath(lang);
const canonical = absoluteUrl(path);
const cloud = services.find(s => s.id === 'cloud-ai')!;
const structuredData = [
  { '@type': 'SoftwareApplication', '@id': canonical + '#product', name: product.name, url: canonical,
    description: product.lead[lang], applicationCategory: 'BusinessApplication', operatingSystem: 'Ubuntu LTS',
    featureList: product.layers.map(layer => layer.title[lang]), publisher: { '@id': absoluteUrl('/#organization') },
    audience: { '@type': 'BusinessAudience', audienceType: product.audiences.map(audience => audience.title[lang]).join(', ') } },
  { '@type': 'FAQPage', '@id': canonical + '#faq', inLanguage: lang, isPartOf: { '@id': canonical + '#webpage' },
    mainEntity: product.faq.map(item => ({ '@type': 'Question', name: item.question[lang],
      acceptedAnswer: { '@type': 'Answer', text: item.answer[lang] } })) },
];
// Opens the contact form with the Swirl Cloud demo request selected.
const demo = `${homePath(lang)}?topic=demo#contact`;
---
<Subpage lang={lang} path={path} title={`${siteConfig.name} | ${product.title[lang]}`} description={product.description[lang]}
  breadcrumbs={[{ name: product.name, path }]} structuredData={structuredData}
  webPage={{ mainEntity: { '@id': canonical + '#product' } }}>
  <article class="service-page product-page">
    <header class="case-intro">
      <p class="eyebrow section-kicker">{product.name.toLocaleUpperCase(lang)}</p>
      <h1>{product.heading[lang]} <span>{product.accent[lang]}</span></h1>
      <p class="case-lead">{product.lead[lang]}</p>
      <div class="hero-actions">
        <a class="button" href={demo}>{en ? 'Request a demo' : 'Demander une démo'} <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#platform">{en ? 'What one installation includes' : 'Ce que comprend une installation'} <span aria-hidden="true">↓</span></a>
      </div>
      <ul class="tags case-tags" aria-label="Technologies">{product.tags.map(tag => <li>{tag}</li>)}</ul>
    </header>
    <section class="service-section" aria-labelledby="audience-heading">
      <h2 id="audience-heading">{en ? 'Who it is for' : 'À qui s’adresse Swirl Cloud'}</h2>
      <p class="product-intro">{product.audienceIntro[lang]}</p>
      <div class="service-capabilities">
        {product.audiences.map(card => <section class="service-card"><h3>{card.title[lang]}</h3><p>{card.text[lang]}</p></section>)}
      </div>
    </section>
    <section class="service-section" id="platform" aria-labelledby="platform-heading">
      <h2 id="platform-heading">{en ? 'What one installation includes' : 'Ce que comprend une installation'}</h2>
      <p class="product-intro">{product.layersIntro[lang]}</p>
      <ol class="product-layers">
        {product.layers.map((layer, index) => <li class="service-card"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{layer.title[lang]}</h3><p>{layer.text[lang]}</p></li>)}
      </ol>
      <ul class="product-more">
        <li><a class="text-link" href={productPagePath('how-it-works', lang)}>{en ? 'How it works: installation, architecture and recovery' : 'Comment elle fonctionne : installation, architecture et reprise'} <span aria-hidden="true">↗</span></a></li>
        <li><a class="text-link" href={productPagePath('sovereignty', lang)}>{en ? 'Sovereignty: where your data goes and every outside service' : 'Souveraineté : où vont vos données et chaque service externe'} <span aria-hidden="true">↗</span></a></li>
        <li><a class="text-link" href={productPagePath('security', lang)}>{en ? 'Security and compliance: the controls and their evidence' : 'Sécurité et conformité : les contrôles et leurs preuves'} <span aria-hidden="true">↗</span></a></li>
      </ul>
    </section>
    <section class="service-section" aria-labelledby="delivery-heading">
      <h2 id="delivery-heading">{en ? 'How it is delivered' : 'Comment elle est livrée'}</h2>
      <p class="product-intro">{product.deliveryIntro[lang]}</p>
      <ol class="service-steps product-delivery">
        {product.delivery.map((option, index) => <li>
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <p class:list={['product-status', { roadmap: !option.available }]}>{option.available ? (en ? 'Available' : 'Disponible') : (en ? 'Roadmap' : 'En préparation')}</p>
          <h3>{option.title[lang]}</h3><p>{option.text[lang]}</p>
        </li>)}
      </ol>
    </section>
    <section class="service-section" aria-labelledby="roadmap-heading">
      <h2 id="roadmap-heading">{en ? 'On the roadmap' : 'Feuille de route'}</h2>
      <p class="product-intro">{product.roadmapIntro[lang]}</p>
      <ul class="product-roadmap">{product.roadmap.map(item => <li>{item[lang]}</li>)}</ul>
    </section>
    <section class="service-section" aria-labelledby="faq-heading">
      <h2 id="faq-heading">{en ? 'Frequently asked questions' : 'Questions fréquentes'}</h2>
      <div class="service-faq">
        {product.faq.map(item => <details><summary><h3>{item.question[lang]}</h3></summary><p>{item.answer[lang]}</p></details>)}
      </div>
    </section>
    <aside class="case-contact">
      <h2>{en ? 'See Swirl Cloud on a real installation' : 'Voir Swirl Cloud sur une vraie installation'}</h2>
      <p>{en
        ? 'We show you the platform that runs our own website and applications, then size an installation for your company.'
        : 'Nous vous montrons la plateforme qui fait tourner notre propre site et nos applications, puis nous dimensionnons une installation pour votre entreprise.'}</p>
      <a class="button" href={demo}>{en ? 'Request a demo' : 'Demander une démo'} <span aria-hidden="true">↗</span></a>
    </aside>
    <section class="service-others" aria-labelledby="others-heading">
      <h2 id="others-heading">{en ? 'Related expertise' : 'Expertise associée'}</h2>
      <div class="case-related-grid"><a href={servicePath(cloud.id, lang)}><span class="eyebrow">{cloud.title[lang]}</span><p>{servicePages[cloud.id].description[lang]}</p><span class="text-link">{en ? 'Explore this expertise' : 'Découvrir l’expertise'} ↗</span></a></div>
    </section>
  </article>
</Subpage>
