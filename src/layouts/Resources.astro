---
import { getEntry } from 'astro:content';
import Subpage from './Subpage.astro';
import GuideCards from '../components/GuideCards.astro';
import '../../app/swirl-cloud.css';
import type { Lang } from '../../data/portfolio';
import { absoluteUrl, articlePath, articles, homePath, resourcesPath, siteConfig } from '../../data/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';
const path = resourcesPath(lang);
const canonical = absoluteUrl(path);
const entries = await Promise.all(articles.map(async id => {
  const entry = await getEntry('articles', `${lang}/${id}`);
  if (!entry) throw new Error(`Missing article: ${lang}/${id}`);
  return { id, ...entry.data };
}));
const list = {
  '@type': 'ItemList', '@id': canonical + '#articles', numberOfItems: entries.length,
  itemListElement: entries.map((article, index) => ({ '@type': 'ListItem', position: index + 1,
    name: article.heading, url: absoluteUrl(articlePath(article.id, lang)) })),
};
---
<Subpage lang={lang} path={path}
  title={en ? `${siteConfig.name} | Resources: NIS2, DORA, CRA, Cloud Exit, E-Invoicing` : `${siteConfig.name} | Ressources : NIS2, DORA, CRA, cloud, facture électronique`}
  description={en
    ? 'Practical guides on NIS2, DORA, the Cyber Resilience Act, leaving a hyperscaler and French e-invoicing: what the rules require, where they stand and what to prepare.'
    : 'Guides pratiques sur NIS2, DORA, le Cyber Resilience Act, la sortie d’un hyperscaler et la facture électronique : ce qu’exigent les textes et quoi préparer.'}
  breadcrumbs={[{ name: en ? 'Resources' : 'Ressources', path }]} structuredData={[list]}
  webPage={{ '@type': 'CollectionPage', mainEntity: { '@id': canonical + '#articles' } }}>
  <header class="case-intro">
    <p class="eyebrow section-kicker">{en ? 'RESOURCES' : 'RESSOURCES'}</p>
    <h1>{en ? 'Resources.' : 'Ressources.'} <span>{en ? 'Rules and practice, checked.' : 'Les règles et la pratique, vérifiées.'}</span></h1>
    <p class="case-lead">{en
      ? 'Guides on the regulations and choices that shape a company’s IT, with their sources and the date they were last checked.'
      : 'Des guides sur les règles et les choix qui façonnent l’informatique d’une entreprise, avec leurs sources et la date de leur dernière vérification.'}</p>
  </header>
  <GuideCards lang={lang} ids={articles} heading="Guides" />
  <aside class="case-contact">
    <h2>{en ? 'Have a question these guides do not answer?' : 'Une question à laquelle ces guides ne répondent pas ?'}</h2>
    <p>{en ? 'Tell us about your context; we reply with what applies to you.' : 'Parlez-nous de votre contexte ; nous vous répondons sur ce qui s’applique à vous.'}</p>
    <a class="button" href={`${homePath(lang)}#contact`}>{en ? 'Contact Swirl' : 'Contacter Swirl'} <span aria-hidden="true">↗</span></a>
  </aside>
</Subpage>
