---
import Layout from './Layout.astro';
import SiteFooter from '../../components/SiteFooter';
import SiteHeader from '../../components/SiteHeader';
import SiteChat from '../../components/SiteChat.astro';
import { services, type Lang } from '../../data/portfolio';
import { homePath, productPath, projectsPath, resourcesPath, servicePath, siteConfig, contactPath } from '../../data/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';
const home = homePath(lang);
const links = [
  [home, en ? 'Home' : 'Accueil'],
  ...services.map(service => [servicePath(service.id, lang), service.title[lang]]),
  [productPath(lang), 'Swirl Cloud'],
  [resourcesPath(lang), en ? 'Resources' : 'Ressources'],
  [projectsPath(lang), en ? 'Case studies' : 'Références'],
  [contactPath(lang), 'Contact'],
];
---
<Layout lang={lang} noindex title={`${siteConfig.name} | ${en ? 'Page not found' : 'Page introuvable'}`}
  description={en ? 'This page does not exist or has moved.' : 'Cette page n’existe pas ou a été déplacée.'}>
  <a class="skip-link" href="#main">{en ? 'Skip to content' : 'Aller au contenu'}</a>
  <SiteHeader lang={lang} home={home} alternates={{ fr: homePath('fr'), en: homePath('en') }} />
  <main id="main" class="case-page wrap not-found">
    <p class="eyebrow section-kicker">404</p>
    <h1>{en ? 'This page could not be found.' : 'Cette page est introuvable.'}</h1>
    <p class="case-lead">{en ? 'The link may be outdated or the address mistyped. Here is where to go next:' : 'Le lien est peut-être ancien ou l’adresse contient une erreur. Voici où poursuivre :'}</p>
    <ul>{links.map(([href, label]) => <li><a class="text-link" href={href}>{label} <span aria-hidden="true">↗</span></a></li>)}</ul>
  </main>
  <SiteFooter lang={lang} />
  <SiteChat lang={lang} />
</Layout>
