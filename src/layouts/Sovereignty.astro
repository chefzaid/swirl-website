---
import Subpage from './Subpage.astro';
import GuideCards from '../../components/GuideCards.astro';
import '../../styles/swirl-cloud.css';
import ContactCta from '../../components/ContactCta.astro';
import type { Lang } from '../../data/portfolio';
import { product } from '../../data/product';
import { security } from '../../data/security';
import { sovereignty as page } from '../../data/sovereignty';
import { absoluteUrl, productPagePath, productPath, siteConfig, relatedArticles, demoPath } from '../../data/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';
const path = productPagePath('sovereignty', lang);
const canonical = absoluteUrl(path);
const overview = productPath(lang);
const structuredData = [
  { '@type': 'FAQPage', '@id': canonical + '#faq', inLanguage: lang, isPartOf: { '@id': canonical + '#webpage' },
    mainEntity: page.faq.map(item => ({ '@type': 'Question', name: item.question[lang],
      acceptedAnswer: { '@type': 'Answer', text: item.answer[lang] } })) },
];
---
<Subpage lang={lang} path={path} title={`${siteConfig.name} | ${page.title[lang]}`} description={page.description[lang]}
  breadcrumbs={[{ name: product.name, path: overview }, { name: en ? 'Sovereignty' : 'Souveraineté', path }]}
  structuredData={structuredData} webPage={{ about: { '@id': absoluteUrl(overview) + '#product' } }}>
  <article class="service-page product-page">
    <header class="case-intro">
      <p class="eyebrow section-kicker">{product.name.toLocaleUpperCase(lang)}</p>
      <h1>{page.heading[lang]} <span>{page.accent[lang]}</span></h1>
      <p class="case-lead">{page.lead[lang]}</p>
      <div class="hero-actions">
        <a class="button" href={demoPath(lang)}>{en ? 'Request a demo' : 'Demander une démo'} <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#services">{en ? 'See every outside service' : 'Voir chaque service externe'} <span aria-hidden="true">↓</span></a>
      </div>
      <ul class="tags case-tags" aria-label="Technologies">{page.tags.map(tag => <li>{tag}</li>)}</ul>
    </header>
    <section class="service-section" aria-labelledby="control-heading">
      <h2 id="control-heading">{en ? 'What stays with you' : 'Ce qui reste chez vous'}</h2>
      <div class="service-capabilities">
        {page.control.map(card => <section class="service-card"><h3>{card.title[lang]}</h3><p>{card.text[lang]}</p></section>)}
      </div>
    </section>
    <section class="service-section" id="services" aria-labelledby="services-heading">
      <h2 id="services-heading">{en ? 'Every outside service' : 'Chaque service externe'}</h2>
      <p class="product-intro">{en
        ? 'The services the platform contacts while installing and running, and what each one receives.'
        : 'Les services que la plateforme contacte à l’installation et en fonctionnement, et ce que chacun reçoit.'}</p>
      <ul class="card-list">
        {page.services.map(service => <li class="service-card">
          <span class:list={['card-badge', { manual: service.optional }]}>{service.optional ? (en ? 'Optional' : 'Optionnel') : (en ? 'Default' : 'Par défaut')}</span>
          <h3>{service.name[lang]}</h3>
          <dl class="service-facts">
            <div><dt>{en ? 'Provider' : 'Fournisseur'}</dt><dd>{service.provider[lang]}</dd></div>
            <div><dt>{en ? 'Used for' : 'Usage'}</dt><dd>{service.use[lang]}</dd></div>
            <div><dt>{en ? 'Receives' : 'Reçoit'}</dt><dd>{service.receives[lang]}</dd></div>
          </dl>
          <p>{service.note[lang]}</p>
        </li>)}
      </ul>
      <p class="product-intro">{page.downloads[lang]}</p>
    </section>
    <section class="service-section" aria-labelledby="exit-heading">
      <h2 id="exit-heading">{en ? 'Free to leave' : 'Libre de partir'}</h2>
      <p class="product-intro">{page.exit[lang]}</p>
    </section>
    <section class="service-section" aria-labelledby="roadmap-heading">
      <h2 id="roadmap-heading">{en ? 'On the roadmap' : 'Feuille de route'}</h2>
      <ul class="product-roadmap">{page.roadmap.map(item => <li>{item[lang]}</li>)}</ul>
    </section>
    <section class="service-section" aria-labelledby="faq-heading">
      <h2 id="faq-heading">{en ? 'Frequently asked questions' : 'Questions fréquentes'}</h2>
      <div class="service-faq">
        {page.faq.map(item => <details><summary><h3>{item.question[lang]}</h3></summary><p>{item.answer[lang]}</p></details>)}
      </div>
    </section>
    <GuideCards lang={lang} ids={relatedArticles.sovereignty} heading={en ? 'Related guides' : 'Guides associés'} />
    <ContactCta lang={lang} action="demo"
      heading={en ? 'Check it on a real installation' : 'Vérifiez-le sur une vraie installation'}
      text={en
      ? 'We show you where each piece of data lives on our own installation and plan yours with the host and country you need.'
      : 'Nous vous montrons où vit chaque donnée sur notre propre installation et préparons la vôtre avec l’hébergeur et le pays dont vous avez besoin.'} />
    <section class="service-others" aria-labelledby="others-heading">
      <h2 id="others-heading">{product.name}</h2>
      <div class="case-related-grid">
        <a href={overview}><span class="eyebrow">{en ? 'Overview' : 'Présentation'}</span><p>{product.description[lang]}</p><span class="text-link">{en ? 'Discover Swirl Cloud' : 'Découvrir Swirl Cloud'} ↗</span></a>
        <a href={productPagePath('security', lang)}><span class="eyebrow">{en ? 'Security and compliance' : 'Sécurité et conformité'}</span><p>{security.description[lang]}</p><span class="text-link">{en ? 'See the controls' : 'Voir les contrôles'} ↗</span></a>
      </div>
    </section>
  </article>
</Subpage>
