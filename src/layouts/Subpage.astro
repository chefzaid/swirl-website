---
import Layout from './Layout.astro';
import SiteFooter from '../../components/SiteFooter';
import type { Lang } from '../../data/portfolio';
import { documentRoutes, homePath, productPath, projectsPath } from '../../data/site';
interface Props {
  lang: Lang; path: string; title: string; description: string;
  // Trail after the homepage; the last item is the current page.
  breadcrumbs: { name: string; path: string }[];
  structuredData?: Record<string, unknown>[];
  webPage?: Record<string, unknown>;
}
const { lang, path, title, description, breadcrumbs, structuredData, webPage } = Astro.props;
const en = lang === 'en';
const home = homePath(lang);
const alternates = documentRoutes.find(route => route.path === path)!.alternates;
const nav = [
  [`${home}#expertises`, en ? 'Expertise' : 'Expertises'],
  [productPath(lang), 'Swirl Cloud'],
  [projectsPath(lang), en ? 'Projects' : 'Références'],
  [`${home}#about`, en ? 'Company' : 'L’entreprise'],
];
---
<Layout lang={lang} path={path} title={title} description={description} breadcrumbs={breadcrumbs} structuredData={structuredData} webPage={webPage}>
  <a class="skip-link" href="#main">{en ? 'Skip to content' : 'Aller au contenu'}</a>
  <header class="header wrap case-header">
    <a class="brand" href={home} aria-label="Swirl"><img src="/assets/mark.svg" alt="" width="40" height="38" />Swirl<i>.</i></a>
    <nav aria-label={en ? 'Main navigation' : 'Navigation principale'}>
      {nav.map(([href, label]) => <a href={href} aria-current={href === path ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="header-actions">
      <div class="language" aria-label={en ? 'Language' : 'Langue'}>
        <a href={alternates.fr} lang="fr" aria-label="Français" aria-current={!en ? 'page' : undefined}>FR</a>
        <span aria-hidden="true">/</span>
        <a href={alternates.en} lang="en" aria-label="English" aria-current={en ? 'page' : undefined}>EN</a>
      </div>
      <a class="button small" href={`${home}#contact`}>Contact <span aria-hidden="true">↗</span></a>
    </div>
  </header>
  <main id="main" class="case-page wrap">
    <nav class="breadcrumbs" aria-label={en ? 'Breadcrumb' : 'Fil d’Ariane'}>
      <a href={home}>Swirl</a>
      {breadcrumbs.map((crumb, index) => <>
        <span aria-hidden="true">/</span>
        {index === breadcrumbs.length - 1
          ? <span aria-current="page">{crumb.name}</span>
          : <a href={crumb.path}>{crumb.name}</a>}
      </>)}
    </nav>
    <slot />
  </main>
  <SiteFooter lang={lang} />
</Layout>
